{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Backend (Spring Boot)",
            "type": "shell",
            "command": "./mvnw spring-boot:run",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Run Frontend (React)",
            "type": "shell",
            "command": "npm install; npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Run Full App",
            "dependsOn": [
                "Run Backend (Spring Boot)",
                "Run Frontend (React)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
